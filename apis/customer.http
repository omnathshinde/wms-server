### Get all customers
GET {{url}}?siteName=
Authorization: {{token}}
Content-Type: application/json


###


### Get all customers
GET {{url}}/search/records?offset=0&limit=100&siteName=
Authorization: {{token}}
Content-Type: application/json


###


### Get a specific customer by ID
GET {{url}}/1
Authorization: {{token}}
Content-Type: application/json


###


### Create a new customer
POST {{url}}
Authorization: {{token}}
Content-Type: application/json

{
  "siteId": 2,
  "name": "cctech",
  "description":"Shinde"
}


###


### Update a customer
PUT {{url}}/1
Authorization: {{token}}
Content-Type: application/json

{
  "siteId": 6,
  "name": "Pune"
}


###


### Delete a customer
DELETE {{url}}/9
Authorization: {{token}}
Content-Type: application/json

### Restore a customer
PATCH {{url}}/9
Authorization: {{token}}
Content-Type: application/json


### Create Bulk customers
POST {{url}}/bulk-records
Authorization: {{token}}
Content-Type: application/json

[
  { "siteId": 1, "name": "ARK India" },
  { "siteId": 2, "name": "ABC Trader" },
  { "siteId": 3, "name": "XYZ Industries" },
  { "siteId": 4, "name": "LMN Hub" }
]
