### Get all racks
GET {{url}}/rack?status=1
Authorization: {{token}}
Content-Type: application/json


###


### Get all racks
GET {{url}}/rack/search/records?offset=0&limit=100&siteName=l
Authorization: {{token}}
Content-Type: application/json


###


### Get a specific rack by ID
GET {{url}}/rack/1
Authorization: {{token}}
Content-Type: application/json


###


### Create a new rack
POST {{url}}/rack
Authorization: {{token}}
Content-Type: application/json

{
  "zoneId": 3,
  "name": "rack3"
}


###


### Update a rack
PUT {{url}}/rack/1
Authorization: {{token}}
Content-Type: application/json

{
  "zoneId": 6,
  "name": "Pune"
}


###


### Delete a rack
DELETE {{url}}/rack/10
Authorization: {{token}}
Content-Type: application/json


###


### Create Bulk racks
POST {{url}}/rack/bulk-records
Authorization: {{token}}
Content-Type: application/json

[
  {
    "siteName": "Pune",
    "zoneName": "A-Zone",
    "rackName": "R1"
  },
  {
    "siteName": "Pune",
    "zoneName": "A-Zone",
    "rackName": "R2"
  },
  {
    "siteName": "Mumbai",
    "zoneName": "B-Zone",
    "rackName": "R1"
  },
  {
    "siteName": "Nagpur",
    "zoneName": "C-Zone",
    "rackName": "R1"
  }
]
